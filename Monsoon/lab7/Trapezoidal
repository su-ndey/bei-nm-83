import numpy as np

def trapezoidal_rule(f, a, b, n):
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = f(x)
    return (h / 2.0) * (y[0] + 2 * np.sum(y[1:-1]) + y[-1])


# --- Example ---
if __name__ == "__main__":
    # Integral of x^2 from 0 to 1 (Exact answer = 1/3 ≈ 0.333333)
    f = lambda x: x**2
    result = trapezoidal_rule(f, a=0, b=1, n=10)
    print(f"Trapezoidal Rule: {result:.6f}")