import numpy as np

def simpson_38_rule(f, a, b, n):
    if n % 3 != 0:
        raise ValueError("Number of subintervals 'n' must be a multiple of 3 for Simpson's 3/8 rule.")
    
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = f(x)
    
    # Indices for terms multiplied by 2 (multiples of 3) and 3 (all others)
    mult_2 = np.sum(y[3:-1:3])
    mult_3 = np.sum(y[1:-1]) - mult_2
    
    return (3 * h / 8.0) * (y[0] + 3 * mult_3 + 2 * mult_2 + y[-1])


# --- Example ---
if __name__ == "__main__":
    f = lambda x: x**2
    result = simpson_38_rule(f, a=0, b=1, n=12)
    print(f"Simpson's 3/8 Rule: {result:.6f}")