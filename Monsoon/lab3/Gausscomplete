import numpy as np

def gauss_complete_pivoting(A, b):
    A = A.astype(float)
    b = b.astype(float)
    n = len(b)
    col_order = np.arange(n)  # Track variable order due to column swaps

    # Forward Elimination
    for i in range(n - 1):
        # Find pivot location in submatrix A[i:, i:]
        pivot_row, pivot_col = np.unravel_index(np.argmax(np.abs(A[i:, i:])), A[i:, i:].shape)
        pivot_row += i
        pivot_col += i

        # Swap rows
        if pivot_row != i:
            A[[i, pivot_row]] = A[[pivot_row, i]]
            b[[i, pivot_row]] = b[[pivot_row, i]]

        # Swap columns
        if pivot_col != i:
            A[:, [i, pivot_col]] = A[:, [pivot_col, i]]
            col_order[[i, pivot_col]] = col_order[[pivot_col, i]]

        # Eliminate below
        for j in range(i + 1, n):
            factor = A[j, i] / A[i, i]
            A[j, i:] -= factor * A[i, i:]
            b[j] -= factor * b[i]

    # Back Substitution
    x_permuted = np.zeros(n)
    for i in range(n - 1, -1, -1):
        x_permuted[i] = (b[i] - np.dot(A[i, i + 1:], x_permuted[i + 1:])) / A[i, i]

    # Reorder solution vector back to original variable order
    x = np.zeros(n)
    x[col_order] = x_permuted

    return x


# --- Example Function Call ---
if __name__ == "__main__":
    A = np.array([[2, 1, -1],
                  [-3, -1, 2],
                  [-2, 1, 2]])
    b = np.array([8, -11, -3])

    x = gauss_complete_pivoting(A, b)
    print("Solution (Complete Pivoting):", x)