import numpy as np

def gauss_partial_pivoting(A, b):
    A = A.astype(float)
    b = b.astype(float)
    n = len(b)

    # Forward Elimination
    for i in range(n - 1):
        # Find pivot (row with max absolute value in current column)
        max_row = i + np.argmax(np.abs(A[i:, i]))
        if max_row != i:
            A[[i, max_row]] = A[[max_row, i]]
            b[[i, max_row]] = b[[max_row, i]]

        # Eliminate below
        for j in range(i + 1, n):
            factor = A[j, i] / A[i, i]
            A[j, i:] -= factor * A[i, i:]
            b[j] -= factor * b[i]

    # Back Substitution
    x = np.zeros(n)
    for i in range(n - 1, -1, -1):
        x[i] = (b[i] - np.dot(A[i, i + 1:], x[i + 1:])) / A[i, i]

    return x


# --- Example Function Call ---
if __name__ == "__main__":
    # System:
    #  2x + 1y - 1z = 8
    # -3x - 1y + 2z = -11
    # -2x + 1y + 2z = -3
    A = np.array([[2, 1, -1],
                  [-3, -1, 2],
                  [-2, 1, 2]])
    b = np.array([8, -11, -3])

    x = gauss_partial_pivoting(A, b)
    print("Solution (Partial Pivoting):", x)