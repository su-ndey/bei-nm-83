import numpy as np

def gauss_seidel(A, b, x0=None, tol=1e-5, max_iter=100):
    A = A.astype(float)
    b = b.astype(float)
    n = len(b)
    x = np.zeros(n) if x0 is None else x0.astype(float)
    
    for _ in range(max_iter):
        x_old = x.copy()
        for i in range(n):
            s = sum(A[i, j] * x[j] for j in range(n) if j != i)
            x[i] = (b[i] - s) / A[i, i]
            
        if np.linalg.norm(x - x_old, ord=np.inf) < tol:
            return x
            
    return x


# --- Example Function Call ---
if __name__ == "__main__":
    A = np.array([[10, -1, 2],
                  [1, 10, -1],
                  [1, 1, 10]])
    b = np.array([6, 6, 6])

    root = gauss_seidel(A, b)
    print("Solution (Gauss-Seidel):", root)