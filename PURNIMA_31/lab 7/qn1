def f(x):
    return 1 / (1 + x**3)

# Input
x0 = float(input("Enter lower limit: "))
xn = float(input("Enter upper limit: "))
n = int(input("Enter number of subintervals: "))

# Step size
h = (xn - x0) / n

# Initial sum
result = f(x0) + f(xn)

# Sum of intermediate points
for i in range(1, n):
    x = x0 + i * h
    result += 2 * f(x)

# Apply Trapezoidal Rule formula
area = (h / 2) * result

# Output
print(f"Area under the curve = {area:.4f}")