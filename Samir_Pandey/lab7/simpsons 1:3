def f(x):
    return 1 / (1 + x**3)   
x0 = float(input("enter lower"))
xn = float(input("enter upper"))
n = int(input("enter number of intervals"))
if n % 2 !=0:
    print("n must be even")
h = (xn - x0) / n
result = f(x0) + f(xn)
for i in range(1, n):
    k = x0 + i * h
    if i % 2 == 0:
        result += 2 * f(k)
    else:
        result += 4 * f(k)
result *= h / 3
print("The integral result is:", result)